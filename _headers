/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'unsafe-inline' https://unpkg.com; img-src https://*.tile.openstreetmap.org data:; connect-src https://ipapi.co https://api.ipify.org; font-src 'none'
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
